{
  "expo": {
    "name": "Aura Presence",
    "slug": "aura-presence",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aura.presence.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "production",
        "com.apple.security.application-groups": [
          "group.com.aura.presence.app.onesignal"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.png",
        "backgroundColor": "#0D0D0D"
      },
      "package": "com.aura.presence.app"
    },
    "web": {
      "favicon": "./assets/images/app-icon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ],
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "scheme": "aurapresence",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "oneSignalAppId": "d16df8fd-844a-4fde-b8b0-a60e9ed405ea"
    },
    "install": {
      "exclude": [
        "@react-native-community/datetimepicker",
        "react-native-gesture-handler",
        "react-native-safe-area-context",
        "react-native-svg",
        "react-native-webview",
        "react-native"
      ]
    }
  }
}
