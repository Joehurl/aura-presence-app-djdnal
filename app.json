{
  "expo": {
    "name": "Aura Presence",
    "slug": "aura-presence",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/b44f950f-60e6-4423-a318-0f4982e03e8f.jpeg",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/b44f950f-60e6-4423-a318-0f4982e03e8f.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.joehurl.aura",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/b44f950f-60e6-4423-a318-0f4982e03e8f.jpeg",
        "backgroundColor": "#0D0D0D"
      },
      "package": "com.joehurl.aura"
    },
    "web": {
      "favicon": "./assets/images/b44f950f-60e6-4423-a318-0f4982e03e8f.jpeg",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "scheme": "aurapresence",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}